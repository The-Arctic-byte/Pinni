        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prova en annan skala eller plats."
          }
        }
      }
    },
    "Use this to show rules and permit news that affect me": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "از این برای نشان دادن خبرهای قوانین و اجازه اقامت مربوط به من استفاده کن"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käytä tätä minua koskevien sääntö- ja lupauutisten näyttämiseen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Använd det för att visa regel- och tillståndsnyheter som berör mig"
          }
        }
      }
    },
    "We tell you honestly how each language is checked.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صادقانه می‌گوییم هر زبان چطور بررسی می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kerromme rehellisesti, miten kunkin kielen käännökset tarkistetaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vi berättar ärligt hur varje språk granskas."
          }
        }
      }
    },
    "What matters most to you?": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "چه چیزی برایت مهم‌تر است؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikä on sinulle tärkeintä?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vad är viktigast för dig?"
          }
        }
      }
    },
    "Where are you?": {
      "localizations": {

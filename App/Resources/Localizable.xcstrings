    "AI-assisted draft, checked by an editor" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیش‌نویس با کمک هوش مصنوعی، بررسی‌شده توسط ویراستار"

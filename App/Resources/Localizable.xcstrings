    "Also gather news from my housing provider" : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خبرهای شرکت مسکن من را هم جمع کن"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kerää uutisia myös vuokranantajaltani"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Samla även nyheter från min hyresvärd"
          }
        }
      }
    },
    "An editor checks it before anything is published. Follow its status in Profile → My reports." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "یک ویراستار قبل از انتشار آن را بررسی می‌کند. وضعیتش را در نمایه ← گزارش‌های من دنبال کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toimittaja tarkistaa sen ennen julkaisua. Seuraa sen tilaa kohdassa Profiili → Omat ilmoitukset."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En redaktör kontrollerar den innan något publiceras. Följ dess status under Profil → Mina rapporter."
          }
        }

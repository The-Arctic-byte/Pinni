    "Your area puts nearby news first. Stories only ever show an area, never an address.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "محله‌ات خبرهای نزدیک را اول نشان می‌دهد. خبرها فقط محله را نشان می‌دهند، هرگز نشانی را."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alueesi nostaa lähiuutiset ensimmäisiksi. Uutisissa näkyy aina vain alue, ei koskaan osoitetta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditt område visar närliggande nyheter först. Nyheter visar bara ett område, aldrig en adress."
          }
        }
      }
    },
    "Your home country adds a place on the map with news from there.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کشور خودت یک مکان روی نقشه با خبرهای آنجا اضافه می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kotimaasi lisää kartalle paikan, josta näet sen uutiset."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditt hemland lägger till en plats på kartan med nyheter därifrån."
          }
        }
      }

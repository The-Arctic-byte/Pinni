      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "محله‌ات خبرهای نزدیک را اول نشان می‌دهد. خبرها فقط محله را نشان می‌دهند، هرگز نشانی را."

    "Based on what people with preferences like yours follow. Counts show only when at least 20 people are similar." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بر اساس چیزی که افراد با علاقه‌های مشابه تو دنبال می‌کنند. تعداد فقط وقتی نشان داده می‌شود که دست‌کم ۲۰ نفر مشابه باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perustuu siihen, mitä kaltaisesi ihmiset seuraavat. Määrä näytetään vain, kun samankaltaisia on vähintään 20."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baserat på vad personer med liknande preferenser följer. Antal visas bara när minst 20 är lika."
          }
        }

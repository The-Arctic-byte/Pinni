        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pinni näyttää sijaintisi kartalla, kun napautat Oma sijainti. Sijaintiasi ei lähetetä minnekään."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pinni visar var du är på kartan när du trycker på Min plats. Din plats skickas aldrig någonstans."
          }

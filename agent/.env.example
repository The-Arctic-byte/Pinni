# Ollama Configuration
PINNI_OLLAMA_URL=http://localhost:11434
PINNI_LLM_MODEL=qwen3.5:2b-q4_K_M
PINNI_EMBED_MODEL=nomic-embed-text:latest
PINNI_LLM_ENABLED=1

# Storage
PINNI_DATA_DIR=agent/data
PINNI_SQLITE_PATH=agent/data/pinni.db

# Neo4j (optional, falls back to in-memory graph projection)
PINNI_NEO4J_URI=bolt://localhost:7687
PINNI_NEO4J_USER=neo4j
PINNI_NEO4J_PASSWORD=secret

# MCP Server
PINNI_MCP_HOST=127.0.0.1
PINNI_MCP_PORT=8765
